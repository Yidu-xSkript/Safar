# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# addis (default) or internova
SAFAR_EDITION=addis
# Optional model choice: another Claude model...
# SAFAR_MODEL=claude-sonnet-5
# ...or any OpenAI-compatible endpoint (OpenRouter, Ollama, LM Studio, Azure OpenAI)
# SAFAR_PROVIDER=openai
# SAFAR_MODEL=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# Optional: real supplier sandboxes instead of demo data
DUFFEL_ACCESS_TOKEN=
LITEAPI_ACCESS_TOKEN=
HOTELBEDS_TRANSFERS_ACCESS_TOKEN=
HOTELBEDS_TRANSFERS_SECRET=
HOTELBEDS_ACTIVITIES_ACCESS_TOKEN=
HOTELBEDS_ACTIVITIES_SECRET=
